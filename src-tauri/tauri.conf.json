{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioShare",
  "version": "0.6.0",
  "identifier": "com.xryon.audioshare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4300",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AudioShare",
        "label": "main",
        "width": 400,
        "height": 500,
        "minWidth": 400,
        "minHeight": 500,
        "maxWidth": 400,
        "maxHeight": 500,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
